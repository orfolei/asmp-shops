<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="asmp-addons" status="INFO">
    <Appenders>
        <RollingFile name="ASMP_LOG" fileName="logs/asmp-addons.log"
                     filePattern="logs/asmp-addons-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t/%level] %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="logs/">
                    <IfFileName glob="asmp-addons-*.log"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="AtriocSMP Log" level="debug" additivity="false">
            <AppenderRef ref="ASMP_LOG"/>
        </Logger>
    </Loggers>
</Configuration>